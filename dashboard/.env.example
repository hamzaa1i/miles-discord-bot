# ─── Aurelia dashboard environment ───────────────────────────────────
# Copy to .env.local for local dev. Set the same vars in Vercel for prod.

# Base URL of the bot's Flask API (Render)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Supabase (Realtime subscriptions — optional but recommended)
# Project Settings → API → URL + anon public key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Discord OAuth2 (same application as the bot — Developer Portal → OAuth2)
NEXT_PUBLIC_DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Canonical dashboard URL (used for OAuth redirect + secure cookies)
# set to your deployed URL in production, e.g. https://<your-project>.vercel.app
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# PHASE M — public marketing site
# support server invite — lights up the "support" links on the landing
# page, docs, stats and faq (links hide when unset)
NEXT_PUBLIC_SUPPORT_SERVER_URL=

# canonical site url for SEO/sitemap/OG tags (falls back to NEXTAUTH_URL;
# Vercel's VERCEL_PROJECT_PRODUCTION_URL is also picked up automatically)
NEXT_PUBLIC_SITE_URL=
