# ─── Aurelia dashboard environment ───────────────────────────────────
# Copy to .env.local for local dev. Set the same vars in Vercel for prod.

# Base URL of the bot's Flask API (Render)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Supabase (Realtime subscriptions — optional but recommended)
# Project Settings → API → URL + anon public key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Discord OAuth2 (same application as the bot — Developer Portal → OAuth2)
NEXT_PUBLIC_DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Canonical dashboard URL (used for OAuth redirect + secure cookies)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
