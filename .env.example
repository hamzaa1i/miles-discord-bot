# Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# Groq API Key (get free at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Owner Discord user ID (used for AI personality + owner commands)
OWNER_ID=123456789012345678

# Supabase (free PostgreSQL — optional but recommended for persistent data)
# Get these from your Supabase project dashboard:
# Settings → API → Project URL + anon public key
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key

# Python version for Render
PYTHON_VERSION=3.11.9

# Web dashboard (see dashboard/README.md) — Discord OAuth2 app creds
# from the Discord Developer Portal (same application as the bot).
DISCORD_CLIENT_ID=your_bot_application_id
DISCORD_CLIENT_SECRET=your_oauth_client_secret
# Where the Next.js dashboard is hosted (CORS allow-list + OAuth redirect base)
DASHBOARD_URL=http://localhost:3000
# Server-side OAuth flow redirect (only needed for the Flask exchange flow)
OAUTH_REDIRECT_URI=http://localhost:8080/api/dashboard/oauth/callback
