# Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# ─── AI providers (PHASE N — multi-provider routing) ───────────────
# ALL of these are SERVER-SIDE (Render) ONLY. Never mirror any of them
# into the dashboard as NEXT_PUBLIC_* — no provider key may ever reach
# the browser bundle. GROQ_API_KEY is required; the rest are optional
# and missing keys simply shrink the routing chains (Groq-only = legacy
# behavior, never a crash).

# Required — the always-on emergency floor
GROQ_API_KEY=your_groq_api_key_here

# Optional — primary general-chat provider
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — fallback + PRIMARY for sensitive (moderation) requests
MISTRAL_API_KEY=your_mistral_api_key_here

# Optional — GLM reasoning route (z-ai/glm-5.2:free, daily-budget
# guarded). Reserved for hard requests; never used for ordinary chat.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model overrides (defaults verified Sept 2026 — change only if a
# provider deprecates an id)
#AI_MODEL_GEMINI_CHAT=gemini-3.7-flash
#AI_MODEL_MISTRAL=mistral-small-2603
#AI_MODEL_OPENROUTER_REASONING=z-ai/glm-5.2:free
#AI_MODEL_GROQ_CHAT=qwen/qwen3.6-27b
#AI_MODEL_GROQ_CHAT_FALLBACK=qwen/qwen3.8-27b
#AI_MODEL_GROQ_FAST=openai/gpt-oss-20b
#AI_MODEL_GROQ_REASONING=openai/gpt-oss-120b

# Routing flags
# false = collapse every chain to Groq only (legacy kill switch)
#AI_ROUTER_ENABLED=true
# Privacy: sensitive requests (automod, moderation intents) skip
# Gemini/OpenRouter unless explicitly allowed here. Defaults false —
# free-tier data-handling terms differ, so privacy routing must be
# deliberate.
#AI_ALLOW_GEMINI_SENSITIVE=false
#AI_ALLOW_OPENROUTER_SENSITIVE=false

# OpenRouter free-quota guard (requests per UTC day; deliberately
# below the provider's basic free allowance)
#OPENROUTER_DAILY_BUDGET=45
# Reasoning effort sent for GLM reasoning calls ("high" default;
# set empty to not send the parameter)
#AI_OPENROUTER_REASONING_EFFORT=high

# Owner Discord user ID (used for AI personality + owner commands)
OWNER_ID=123456789012345678

# Supabase (free PostgreSQL — optional but recommended for persistent data)
# Get these from your Supabase project dashboard:
# Settings → API → Project URL + anon public key
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key

# Python version for Render
PYTHON_VERSION=3.11.9

# Web dashboard (see dashboard/README.md) — Discord OAuth2 app creds
# from the Discord Developer Portal (same application as the bot).
DISCORD_CLIENT_ID=your_bot_application_id
DISCORD_CLIENT_SECRET=your_oauth_client_secret
# Where the Next.js dashboard is hosted (CORS allow-list + OAuth redirect base)
# set to your deployed dashboard URL, e.g. https://<your-project>.vercel.app
DASHBOARD_URL=http://localhost:3000
# Server-side OAuth flow redirect (only needed for the Flask exchange flow)
OAUTH_REDIRECT_URI=http://localhost:8080/api/dashboard/oauth/callback

# PHASE M — support server invite (optional but recommended)
# shown in /help footer, error messages, the on-join owner DM and the
# setup wizard when set. everything degrades gracefully when empty.
SUPPORT_SERVER_URL=https://discord.gg/your-support-server
